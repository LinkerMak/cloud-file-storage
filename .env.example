# Пример конфигурации для Cloud File Storage
# Переименуй этот файл в .env.local и заполни безопасными значениями для своей среды

# Общие настройки приложения
SERVER_PORT=8081

# База данных (локальная/дев)
DB_NAME=cloud_storage
DB_URL=jdbc:postgresql://localhost:5432/cloud_storage
DB_USERNAME=cloud_user
DB_PASSWORD=change_me
DB_DRIVER=org.postgresql.Driver

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_SHOW_SQL=true
JPA_OPEN_IN_VIEW=false

# Миграции Flyway
FLYWAY_ENABLED=true

# Redis (сессии)
REDIS_HOST=localhost
REDIS_PORT=6379

SESSION_TTL_SECONDS=1800
SESSION_TTL_REFRESH_THRESHOLD_SECONDS=300
SESSION_COOKIE_NAME=SESSION_ID

# MinIO (локальное хранилище файлов)
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=user-files

# Настройки загрузки файлов
MULTIPART_ENABLED=true
MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=120MB

# Настройки Tomcat для загрузки/форм
TOMCAT_MAX_SWALLOW_SIZE=-1
TOMCAT_MAX_PART_COUNT=500
TOMCAT_MAX_HTTP_FORM_POST_SIZE=120MB

# Документация API (Swagger / OpenAPI)
SWAGGER_ENABLED=true
OPEN_API_ENABLED=true